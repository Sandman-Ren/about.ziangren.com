{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "about-ziangren-com",
  "compatibility_date": "2026-04-20",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}
